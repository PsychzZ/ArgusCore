# Postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=argus
POSTGRES_USER=argus
POSTGRES_PASSWORD=__CHANGE_ME__

# LLM — set LLM_PROVIDER to "deepseek" or "gemini";
# only the API key of the selected provider is required
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=__CHANGE_ME__
DEEPSEEK_MODEL=deepseek-chat
# GEMINI_API_KEY=__CHANGE_ME__
# GEMINI_MODEL=gemini-2.5-flash

# Discord
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/__CHANGE_ME__

# SEC (SEC requires User-Agent with email)
SEC_USER_AGENT=ArgusCore/1.0 (your-email@example.com)

# Operational
LOG_LEVEL=INFO
HEALTH_PORT=8080
# Hour (UTC) for the daily digest message
DIGEST_HOUR=18

# Config files
WATCHLIST_PATH=/app/watchlist.yaml
FEEDS_PATH=/app/feeds.yaml
